# RustPress Configuration

# Server
HOST=127.0.0.1
PORT=8080

# Database
DATABASE_URL=postgres://rustpress:rustpress@localhost:5432/rustpress

# Redis Cache
REDIS_URL=redis://localhost:6379

# Security
# REQUIRED: a strong, random secret of at least 32 characters. The server
# refuses to start with a missing, default, or short secret (token-forgery
# protection). Generate one with: openssl rand -hex 32
# For local development ONLY you may bypass the check with
# RUSTPRESS_ALLOW_INSECURE_JWT=1 (never set this in production).
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32-min-32-chars

# Storage
UPLOAD_DIR=./uploads
THEMES_DIR=./themes

# Logging
RUST_LOG=info
